/* ==========================================================================
   WhalePet 项目专属选择器
   --------------------------------------------------------------------------
   约定（见 skills/qt-ui）：
     - default.qss 必须保持原样，本文件仅「新增」项目自有控件的规则；
     - 不覆盖 default.qss 中任何既有选择器与取值；
     - 颜色一律取自 default.qss 的调色板（黑/白/灰，无彩色）。
   ========================================================================== */

/* 台词气泡：深色底 + 圆角 + 白字（docs/PRESENTATION.md §4）。
   圆角取值沿用 default.qss 中已存在的 7px，不另创数值。 */
#SpeechBubble {
    background-color: #000000;
    color: #FFFFFF;
    border: 1px solid #3C3C3C;
    border-radius: 7px;
}

#SpeechBubble QLabel {
    background-color: transparent;
    color: #FFFFFF;
}

/* 预设对话提问面板（P8，docs/DIALOGUE.md §3）：与台词气泡同一套取值，
   只新增项目控件规则，颜色全部取自 default.qss 调色板（黑/白/灰，无彩色）。 */
#DialoguePanel {
    background-color: #000000;
    color: #FFFFFF;
    border: 1px solid #3C3C3C;
    border-radius: 7px;
}

#DialoguePanel QLabel {
    background-color: transparent;
    color: #FFFFFF;
}

/* 回答按钮：左对齐 + 沿用 default.qss 的按钮内边距与悬停/按下取值，
   仅补齐「长文本左对齐」这一表现层需要，不新增任何颜色。 */
#DialoguePanel QPushButton {
    text-align: left;
    padding: 6px 14px;
}

/* 扫雷棋盘格（P6+ 小游戏）：仅新增项目控件规则，
   取值全部取自 default.qss 调色板（黑/白/灰，无彩色），不自行设计。
   格子状态由 C++ 侧的动态属性 cellState 驱动：hidden / flag / revealed / mine。 */
#MineBoard QToolButton {
    padding: 0;
    font-weight: bold;
}

#MineBoard QToolButton[cellState="hidden"] {
    background-color: #1F1F1F;
    border: 1px solid #3C3C3C;
    color: #FFFFFF;
}

#MineBoard QToolButton[cellState="hidden"]:hover {
    background-color: #3C3C3C;
}

#MineBoard QToolButton[cellState="flag"] {
    background-color: #1F1F1F;
    border: 1px solid #FFFFFF;
    color: #FFFFFF;
}

#MineBoard QToolButton[cellState="revealed"] {
    background-color: #000000;
    border: 1px solid #2A2A2A;
    color: #FFFFFF;
}

#MineBoard QToolButton[cellState="mine"] {
    background-color: #FFFFFF;
    border: 1px solid #FFFFFF;
    color: #000000;
}

/* 找小猫地图格（小游戏「鲸鱼娘找小猫」）：同样只新增项目控件规则，
   取值全部取自 default.qss 调色板（黑/白/灰，无彩色），不自行设计。
   格子状态由 C++ 侧的动态属性 cellState 驱动：
   floor / wall / player / exit / toy / junk / kitten。
   注意：方块上**不渲染任何文字**（物体名 / 角色名一律不绘制，名称走 tooltip），
   故此处不设置字体相关取值；方块只用配色与边框表达状态。 */
#KittenMap QToolButton {
    padding: 0;
}

#KittenMap QToolButton[cellState="floor"] {
    background-color: #000000;
    border: 1px solid #0D0D0D;
    color: #FFFFFF;
}

#KittenMap QToolButton[cellState="wall"] {
    background-color: #1F1F1F;
    border: 1px solid #3C3C3C;
    color: #FFFFFF;
}

#KittenMap QToolButton[cellState="player"] {
    background-color: #FFFFFF;
    border: 1px solid #FFFFFF;
    color: #000000;
}

#KittenMap QToolButton[cellState="exit"] {
    background-color: #000000;
    border: 1px solid #FFFFFF;
    color: #B0B0B0;
}

#KittenMap QToolButton[cellState="toy"] {
    background-color: #0D0D0D;
    border: 1px solid #B0B0B0;
    color: #FFFFFF;
}

#KittenMap QToolButton[cellState="junk"] {
    background-color: #1F1F1F;
    border: 1px solid #2A2A2A;
    color: #B0B0B0;
}

#KittenMap QToolButton[cellState="kitten"] {
    background-color: #FFFFFF;
    border: 1px solid #FFFFFF;
    color: #000000;
}

/* 国际象棋棋盘格（小游戏「国际象棋」）：只新增项目控件规则，
   取值全部取自 default.qss 调色板（黑/白/灰，无彩色），不自行设计。
   格子由两个动态属性驱动：
     cellState = light / dark（格底色，按 (file+rank) 奇偶）
     moveHint  = none / selected / target / lastmove / check（选中·可走点·上一步·将军） */
#ChessBoard QToolButton {
    padding: 0;
    font-size: 26px;
}

#ChessBoard QToolButton[cellState="light"] {
    background-color: #B0B0B0;
    border: 1px solid #B0B0B0;
    color: #000000;
}

#ChessBoard QToolButton[cellState="dark"] {
    background-color: #1F1F1F;
    border: 1px solid #1F1F1F;
    color: #FFFFFF;
}

#ChessBoard QToolButton[moveHint="selected"] {
    border: 2px solid #FFFFFF;
}

#ChessBoard QToolButton[moveHint="target"] {
    border: 2px solid #FFFFFF;
}

#ChessBoard QToolButton[moveHint="lastmove"] {
    border: 1px solid #FFFFFF;
}

#ChessBoard QToolButton[moveHint="check"] {
    background-color: #FFFFFF;
    border: 2px solid #FFFFFF;
    color: #000000;
}

/* 拖动中的棋子浮影（ChessBoardWidget 拖动时跟随光标的临时 QLabel）：
   只新增项目控件规则，取值全部取自 default.qss 调色板。 */
#ChessDragGhost {
    background-color: #1F1F1F;
    border: 1px solid #FFFFFF;
    color: #FFFFFF;
    font-size: 26px;
}

/* 接 Token 棋盘格（小游戏「接 Token」）：只新增项目控件规则，
   取值全部取自 default.qss 调色板（黑/白/灰，无彩色），不自行设计。
   格子状态由 C++ 侧的动态属性 cellState 驱动：
   empty（空）/ token（Token，界面字「币」）/ rice（白饭，界面字「饭」）/ catcher（接取区）。 */
#TokenCatchBoard QToolButton {
    padding: 0;
    font-weight: bold;
}

#TokenCatchBoard QToolButton[cellState="empty"] {
    background-color: #000000;
    border: 1px solid #0D0D0D;
    color: #FFFFFF;
}

#TokenCatchBoard QToolButton[cellState="token"] {
    background-color: #1F1F1F;
    border: 1px solid #B0B0B0;
    color: #FFFFFF;
}

#TokenCatchBoard QToolButton[cellState="rice"] {
    background-color: #FFFFFF;
    border: 1px solid #FFFFFF;
    color: #000000;
}

#TokenCatchBoard QToolButton[cellState="catcher"] {
    background-color: #1F1F1F;
    border: 2px solid #FFFFFF;
    color: #FFFFFF;
}

/* 「小游戏…」下拉列表（右键 / 托盘两个实例，objectName 见 PetWindow::setupContextMenu /
   setupTray）：与父菜单共用 default.qss 的 QMenu / QMenu::item 规则（黑底白字、悬停反色、
   1px 边框、同样的项内边距），因此父项与下拉项视觉一致——此处仅统一列表最小宽度，
   避免插件数量不同时宽度跳动；不新增任何颜色，子菜单指示符由样式按全局调色板绘制。 */
#MiniGameMenu,
#TrayMiniGameMenu {
    min-width: 140px;
}
